<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Soft Drop Glow Shadow under glyph -->
    <path
        android:pathData="M54,30 L73,78 L63,78 L54,55 L45,78 L35,78 Z"
        android:fillColor="#4000F2FE" />

    <!-- Left Strut of 'A' with Electric Cyan Gradient -->
    <path
        android:pathData="M54,26 L54,34 L40,76 L31,76 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="31"
                android:startY="76"
                android:endX="54"
                android:endY="26"
                android:type="linear">
                <item android:color="#00C9FF" android:offset="0.0" />
                <item android:color="#00F2FE" android:offset="0.6" />
                <item android:color="#FFFFFF" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Right Strut of 'A' with Vivid Violet to Magenta Gradient -->
    <path
        android:pathData="M54,26 L77,76 L68,76 L54,34 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="54"
                android:startY="26"
                android:endX="77"
                android:endY="76"
                android:type="linear">
                <item android:color="#FFFFFF" android:offset="0.0" />
                <item android:color="#7928CA" android:offset="0.5" />
                <item android:color="#FF007A" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Glowing Apex Crown Accent -->
    <path
        android:pathData="M54,24 L57,30 L51,30 Z"
        android:fillColor="#FFFFFF" />

    <!-- Infinity Sync Cross-Bridge: Left Loop Arc -->
    <path
        android:pathData="M54,58 C46,58 38,53 38,48 C38,43 46,45 54,58 Z"
        android:strokeWidth="3.2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="38"
                android:startY="48"
                android:endX="54"
                android:endY="58"
                android:type="linear">
                <item android:color="#00F2FE" android:offset="0.0" />
                <item android:color="#9D4EDD" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Infinity Sync Cross-Bridge: Right Loop Arc -->
    <path
        android:pathData="M54,58 C62,58 70,63 70,68 C70,73 62,71 54,58 Z"
        android:strokeWidth="3.2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="54"
                android:startY="58"
                android:endX="70"
                android:endY="68"
                android:type="linear">
                <item android:color="#9D4EDD" android:offset="0.0" />
                <item android:color="#FF007A" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Dynamic Central Core Connector / Hyper-Drive Node -->
    <path
        android:pathData="M54,54 A4.2,4.2 0 1,1 53.9,54 Z"
        android:fillColor="#FFFFFF" />
    <path
        android:pathData="M54,55 A2.2,2.2 0 1,1 53.9,55 Z"
        android:fillColor="#00F2FE" />

    <!-- Left Orbital Node -->
    <path
        android:pathData="M40,51 A2.4,2.4 0 1,1 39.9,51 Z"
        android:fillColor="#00F2FE" />

    <!-- Right Orbital Node -->
    <path
        android:pathData="M68,65 A2.4,2.4 0 1,1 67.9,65 Z"
        android:fillColor="#FF007A" />

</vector>
