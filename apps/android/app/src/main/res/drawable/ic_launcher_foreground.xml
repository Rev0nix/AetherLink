<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Soft Drop Glow Shadow under V glyph -->
    <path
        android:pathData="M54,82 L30,30 L43,30 L54,58 L65,30 L78,30 Z"
        android:fillColor="#4000F2FE" />

    <!-- Left Wing of 'V' with Electric Cyan Gradient -->
    <path
        android:pathData="M30,30 L43,30 L54,64 L54,78 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="30"
                android:startY="30"
                android:endX="54"
                android:endY="78"
                android:type="linear">
                <item android:color="#FFFFFF" android:offset="0.0" />
                <item android:color="#00F2FE" android:offset="0.5" />
                <item android:color="#0072FF" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Right Wing of 'V' with Vivid Violet to Magenta Gradient -->
    <path
        android:pathData="M78,30 L65,30 L54,64 L54,78 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="78"
                android:startY="30"
                android:endX="54"
                android:endY="78"
                android:type="linear">
                <item android:color="#FF007A" android:offset="0.0" />
                <item android:color="#7928CA" android:offset="0.5" />
                <item android:color="#9D4EDD" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Left Inner Facet Accent -->
    <path
        android:pathData="M43,30 L48,30 L54,54 L54,64 Z"
        android:fillColor="#33FFFFFF" />

    <!-- Right Inner Facet Accent -->
    <path
        android:pathData="M65,30 L60,30 L54,54 L54,64 Z"
        android:fillColor="#22FFFFFF" />

    <!-- Central Glowing Core / Hexagonal Cyber Node -->
    <path
        android:pathData="M54,34 L60,40 L60,48 L54,54 L48,48 L48,40 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="48"
                android:startY="34"
                android:endX="60"
                android:endY="54"
                android:type="linear">
                <item android:color="#00F2FE" android:offset="0.0" />
                <item android:color="#9D4EDD" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Inner Core Sparkle / Node Center -->
    <path
        android:pathData="M54,44 A3,3 0 1,1 53.9,44 Z"
        android:fillColor="#FFFFFF" />

    <!-- Wing Tip Node - Left -->
    <path
        android:pathData="M36,30 A3.5,3.5 0 1,1 35.9,30 Z"
        android:fillColor="#00F2FE" />

    <!-- Wing Tip Node - Right -->
    <path
        android:pathData="M72,30 A3.5,3.5 0 1,1 71.9,30 Z"
        android:fillColor="#FF007A" />

    <!-- Bottom Vertex Anchor Node -->
    <path
        android:pathData="M54,78 A3,3 0 1,1 53.9,78 Z"
        android:fillColor="#00F2FE" />

</vector>
