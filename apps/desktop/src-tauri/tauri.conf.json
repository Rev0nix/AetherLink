{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VEXYRON",
  "version": "2.3.4",
  "mainBinaryName": "vexyron",
  "identifier": "com.vexyron.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "VEXYRON",
        "width": 1050,
        "height": 680,
        "resizable": true,
        "fullscreen": false,
        "maximized": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Universal device companion and synchronization across laptops and mobile devices",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "installer.nsh"
      }
    },
    "linux": {
      "deb": {
        "section": "net",
        "priority": "optional",
        "preInstallScript": "preinst.sh",
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0"
        ],
        "replaces": [
          "aether-link",
          "aetherlink",
          "desktop"
        ],
        "conflicts": [
          "aether-link",
          "aetherlink"
        ],
        "provides": [
          "aether-link",
          "aetherlink"
        ]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
